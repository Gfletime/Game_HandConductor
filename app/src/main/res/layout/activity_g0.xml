<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/iv_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"/>
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:clipChildren="false"
    android:clipToPadding="false">

    <ImageView
        android:id="@+id/iv_main_cover"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="32dp"
        android:background="#1E1E1E"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/rv_song_list"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <Button
        android:id="@+id/btn_back_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="返回"
        android:backgroundTint="#80424242"
        android:textColor="@android:color/white"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:elevation="5dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btn_goto_settings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="设置"
        android:backgroundTint="#80424242"
        android:textColor="@android:color/white"
        android:elevation="5dp"
        app:layout_constraintStart_toEndOf="@id/btn_back_title"
        app:layout_constraintTop_toTopOf="@id/btn_back_title" />

    <TextView
        android:id="@+id/tv_main_rank"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="S"
        android:textSize="85sp"
        android:textStyle="bold"
        android:includeFontPadding="false"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:elevation="5dp"
        app:layout_constraintTop_toTopOf="@id/iv_main_cover"
        app:layout_constraintEnd_toEndOf="@id/iv_main_cover" />

    <LinearLayout
        android:id="@+id/layout_text_overlay"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#A6212121"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp"
        android:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="@id/iv_main_cover"
        app:layout_constraintStart_toStartOf="@id/iv_main_cover"
        app:layout_constraintEnd_toEndOf="@id/iv_main_cover">

        <TextView
            android:id="@+id/tv_song_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="当前选择: 未知"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="start|center_vertical" />

        <LinearLayout
            android:id="@+id/layout_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_best_completion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="最好完成度: 0%"
                android:textColor="#D3D3D3"
                android:textSize="16sp"
                android:gravity="start" />

            <TextView
                android:id="@+id/tv_max_combo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="最大combo: 0"
                android:textColor="#D3D3D3"
                android:textSize="16sp"
                android:gravity="start" />
        </LinearLayout>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_song_list"
        android:layout_width="160dp"
        android:layout_height="0dp"
        android:paddingTop="200dp"
        android:paddingBottom="200dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>